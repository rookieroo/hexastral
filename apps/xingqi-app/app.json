{
  "expo": {
    "name": "Syel",
    "slug": "xingqi",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "syel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F1EA",
      "dark": {
        "backgroundColor": "#121211"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hexastral.syel",
      "deploymentTarget": "15.1",
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:hexastral.com",
        "applinks:www.hexastral.com",
        "applinks:syel.hexastral.com"
      ],
      "infoPlist": {
        "CFBundleDisplayName": "Syel",
        "UIUserInterfaceStyle": "Automatic",
        "NSCameraUsageDescription": "Syel uses the camera to capture left palm, right palm, and face photos for structured form-qi cultural study — not medical diagnosis.",
        "NSPhotoLibraryUsageDescription": "Syel accesses your photo library when you choose existing palm or face photos for form-qi cultural study.",
        "UIBackgroundModes": ["remote-notification"],
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyTracking": false
      },
      "appleTeamId": "L9Z47DW56X"
    },
    "android": {
      "package": "com.hexastral.syel",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      }
    },
    "extra": {
      "router": { "origin": false },
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" },
      "REVENUECAT_IOS_API_KEY": "REPLACE_WITH_REVENUECAT_IOS_API_KEY",
      "REVENUECAT_ANDROID_API_KEY": "REPLACE_WITH_REVENUECAT_ANDROID_API_KEY"
    },
    "owner": "useone-tech",
    "experiments": { "typedRoutes": true },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      "./plugins/withAutomaticAppearance.js",
      "./plugins/withIosPodDeploymentTarget.cjs",
      "./plugins/withGoogleModularHeaders.js",
      [
        "expo-apple-authentication",
        { "iosTeamId": "L9Z47DW56X" }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Syel uses the camera to capture left palm, right palm, and face photos for structured form-qi cultural study — not medical diagnosis.",
          "photosPermission": "Syel accesses your photo library when you choose existing palm or face photos for form-qi cultural study."
        }
      ]
    ]
  }
}
