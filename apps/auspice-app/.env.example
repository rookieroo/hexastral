# Yuun (auspice-app) — local development env
# Copy to `.env.local` and fill in. Production values also live in eas.json.
# Restart Metro after changes (`bun run dev`).

EXPO_PUBLIC_API_URL=https://api.hexastral.com
EXPO_PUBLIC_ENV=development

# After `eas init` — UUID from Expo dashboard / app.json extra.eas.projectId
# EXPO_PUBLIC_EAS_PROJECT_ID=

# Google Sign-In (Cloud Console → APIs & Services → Credentials)
# iOS / Android clients are already used by the native plugin in app.json.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=443209724807-74241r1rvca3nb4io9o6184ddrkhtf7m.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=443209724807-nt26socuql9j5jmsrd1ve9h8ap7i3ubp.apps.googleusercontent.com
# REQUIRED for idToken on both platforms — OAuth client type "Web application"
# (not iOS/Android). Also add this id to Worker secret GOOGLE_OAUTH_AUDIENCES.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
