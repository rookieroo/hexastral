{
  "name": "@zhop/widget-kit-ios",
  "version": "0.1.0",
  "private": true,
  "description": "iOS WidgetKit + WatchKit infrastructure for HexAstral satellite apps. Expo config plugin generates Widget Extension target + App Group entitlement; RN-side useWidgetSync hook bridges TimelineProvider state.",
