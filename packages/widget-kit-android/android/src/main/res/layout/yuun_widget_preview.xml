<?xml version="1.0" encoding="utf-8"?>
<!-- Static RemoteViews used by the widget picker preview (not Glance). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="12dp"
  android:background="#F4F1EA">
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="@string/yuun_widget_preview_subtitle"
    android:textColor="#71717A"
    android:textSize="11sp" />
  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:text="@string/yuun_widget_preview_title"
    android:textColor="#09090B"
    android:textSize="16sp"
    android:textStyle="bold" />
</LinearLayout>
